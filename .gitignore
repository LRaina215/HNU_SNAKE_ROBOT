/tmp/
*.log
/docs/**/*.zip
/*.pptx

# Repository storage policy (supersedes older experiment-specific rules above).
# Raw runs, media, arrays, checkpoints, JSON logs and repeated source/model
# snapshots stay on the local machine. Publish descriptions and curated source.
/experiments/**/*
!/experiments/**/
!/experiments/**/*.md
!/experiments/*/*.py

# Current global/local research: maintained stage code and the successful base.
!/experiments/u03_global_curve_compliance_20261012/STEP*/*.py
!/experiments/u03_global_curve_compliance_20261012/A16/*.py
!/experiments/u03_global_curve_compliance_20261012/STEP1_20261014/R1_READY_FROZEN/*.py

